---
import Video from '../components/story/Video.astro';
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import LoopFlow from '../components/diagrams/LoopFlow.astro';
import { publishedPosts } from '../lib';
import { SITE } from '../site';
const posts = (await publishedPosts()).filter((p) => p.data.type !== 'build-log').slice(0, 4);
const jsonld = { '@context': 'https://schema.org', '@type': 'WebSite', name: 'programmiere.de', url: 'https://programmiere.de/', author: { '@type': 'Person', name: SITE.author } };
---
<Base wide jsonld={jsonld} description="Matrix for Claude Code: a free plugin that gives Claude Code a local index of your documents. 42 instead of 126 seconds per question, about half the input tokens, measured on 442 pages. Also Matrix LLM, an app for iPhone, iPad, Mac and Windows, a GDPR-friendly WordPress spam filter and the AI loop that maintains it.">
  <section class="hero">
    <div class="in">
      <p class="project">Matrix for Claude Code · free plugin</p>
      <h1>Claude Code on your documents: 3× faster, half the tokens.</h1>
      <p class="sub">42 seconds per question instead of 126, and 305k tokens instead of 660k. Measured on 442 pages
      of EU regulations. Every answer comes with file, page and passage.</p>
      <div class="vid"><Video src="/video/matrix-claude-code-1080p.mp4" poster="/video/matrix-claude-code-poster.jpg" /></div>
      <pre class="install"><code>claude plugin marketplace add matthiasnordwig/matrix-mcp && claude plugin install matrix@matrix-mcp</code></pre>
      <div class="actions"><a class="go" href="/projects/matrix-claude-code/">About the plugin</a></div>
    </div>
  </section>

  <section class="app">
    <div class="in">
      <p class="project">Matrix LLM · iPhone, iPad, Mac and Windows</p>
      <h2>Also as an app for iPhone, iPad, Mac and Windows.</h2>
      <p class="sub">Ask questions about your documents, offline. Every answer shows the exact passage it is based on.
      The models can run entirely on your device: small ones on the iPhone, large ones on a Mac or PC.</p>
      <div class="vid"><Video src="/projects/matrix/matrix-video-1080p.mp4" poster="/projects/matrix/matrix-video-poster.jpg" /></div>
      <div class="actions">
        <a class="badge" href={SITE.matrixApp}><img src="/badges/download-on-the-app-store.svg" width="120" height="40" alt="Download on the App Store" /></a>
        <a class="badge" href={SITE.matrixWin}><img src="/badges/get-it-from-microsoft.svg" width="161" height="44" alt="Get it from Microsoft" /></a>
        <a class="go ghost" href="/projects/matrix/">How it works</a>
      </div>
      <p class="free">Free to download for iPhone, iPad, Mac and Windows.</p>
    </div>
  </section>

  <section class="more">
    <div class="more-inner">
      <article class="door">
        <p class="for">For people building with AI agents</p>
        <h2>An AI maintains my software. It asks me first.</h2>
        <p>It reads the support forums, writes the fix and has to pass checks that are plain code, so no model
        can argue its way past them. Every release, merge or forum reply then waits for a one-word OK from my phone.</p>
        <div class="mini"><LoopFlow /></div>
        <a class="go ghost" href="/projects/maintainer-loop/">How the loop works</a>
      </article>
      <article class="door">
        <p class="for">For WordPress site owners</p>
        <h2>Form spam protection without Google.</h2>
        <p>A free plugin that stops form spam without tracking anyone. The visitor's browser solves a small
        computing task (a proof of work) instead. No cookies, no third-party calls, no puzzles to click. It runs
        on about 4,000 sites.</p>
        <ul class="ticks">
          <li>Works with the common form builders without setup</li>
          <li>No Google account to set up, nothing to add to the cookie banner</li>
        </ul>
        <a class="go ghost" href="/projects/gdpr-recaptcha/">About the plugin</a>
      </article>
    </div>
  </section>

  {posts.length > 0 && (
    <section class="latest">
      <div class="narrow">
        <h2>Latest writing</h2>
        <PostList posts={posts} />
        <a class="go ghost" href="/writing/">All writing</a>
      </div>
    </section>
  )}

  <section class="who">
    <div class="narrow">
      <p>I'm {SITE.author}. I work on AI and data in financial services and build these projects after hours,
      mostly by directing and checking AI agents. <a href="/about/">About</a> · <a href="/cv/">CV</a></p>
    </div>
  </section>
</Base>

<style>
  .hero, .app { padding: clamp(2.5rem, 6vw, 4.5rem) 0 clamp(2.5rem, 6vw, 4rem); }
  .app { border-top: 1px solid var(--line); }
  .in { max-width: 56rem; margin: 0 auto; padding: 0 16px; }
  .project { margin: 0 0 .75rem; font-weight: 700; color: var(--accent); }
  h1, h2 { font-family: var(--display); font-weight: 800; letter-spacing: -.035em; line-height: .98; margin: 0 0 1.1rem; font-variation-settings: 'wdth' 78; }
  h1 { font-size: clamp(2.5rem, 5.2vw, 4.4rem); }
  .app h2 { font-size: clamp(1.8rem, 3.4vw, 2.6rem); }
  .sub { font-size: clamp(1.08rem, 1.5vw, 1.2rem); line-height: 1.55; color: var(--muted); max-width: 40rem; margin: 0 0 1.5rem; }
  .vid { margin: 0 0 1.5rem; }
  .install { margin: 0 0 1.5rem; padding: .9rem 1rem; border: 1px solid var(--line); border-radius: 10px; background: var(--surface); overflow-x: auto; font-size: .9rem; }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: .85rem; }
  .actions .badge { display: inline-flex; line-height: 0; }
  .actions .badge img { height: 52px; width: auto; display: block; }
  .actions .go { box-sizing: border-box; height: 52px; display: inline-flex; align-items: center; }
  .free { margin: .8rem 0 0; color: var(--muted); font-size: .95rem; }
  .more { border-top: 1px solid var(--line); background: var(--surface); }
  .more-inner { max-width: 76rem; margin: 0 auto; padding: clamp(3rem, 7vw, 5rem) 16px; display: grid; grid-template-columns: 1fr; gap: 3.5rem 4rem; }
  @media (min-width: 1000px) { .more-inner { grid-template-columns: repeat(2, 1fr); } }
  .for { margin: 0 0 .6rem; font-weight: 700; color: var(--accent); }
  .door h2 { font-size: clamp(1.8rem, 3.4vw, 2.6rem); }
  .door p { color: var(--muted); font-size: 1.08rem; line-height: 1.55; margin: 0 0 1.25rem; max-width: 34rem; }
  .mini { margin: 0 0 1.5rem; }
  .mini :global(img) { width: 100%; height: auto; border-radius: 12px; border: 1px solid var(--line); display: block; }
  .ticks { margin: 0 0 1.5rem; padding-left: 1.2rem; color: var(--fg); }
  .ticks li { margin-bottom: .3rem; }
  .go { display: inline-block; font-weight: 700; text-decoration: none; color: var(--on-accent); background: var(--accent); padding: .7rem 1.2rem; border-radius: 999px; border: 2px solid var(--accent); }
  .go:hover { filter: brightness(1.1); }
  .go.ghost { background: transparent; color: var(--accent); }
  .go.ghost:hover { background: var(--accent); color: var(--on-accent); filter: none; }
  .narrow { max-width: 46rem; margin: 0 auto; padding: 0 16px; }
  .latest { padding: clamp(3rem, 7vw, 5rem) 0; border-top: 1px solid var(--line); }
  .latest h2 { font-size: clamp(1.8rem, 3.4vw, 2.6rem); }
  .who { padding: 2.5rem 0 4rem; color: var(--muted); border-top: 1px solid var(--line); }
  .who p { margin: 0; }
  :focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; }
</style>
