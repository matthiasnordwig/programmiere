---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import LoopFlow from '../components/diagrams/LoopFlow.astro';
import graph from '../assets/projects/matrix-graph.jpg';
import iphoneAsk from '../assets/projects/matrix-iphone-ask.png';
import { publishedPosts } from '../lib';
import { SITE } from '../site';
const posts = (await publishedPosts()).slice(0, 4);
const jsonld = { '@context': 'https://schema.org', '@type': 'WebSite', name: 'programmiere.de', url: 'https://programmiere.de/', author: { '@type': 'Person', name: SITE.author } };
---
<Base wide jsonld={jsonld} description="Matrix LLM: ask your own documents on iPhone, iPad and Mac, offline, with the exact passage as proof and a knowledge graph where every link carries a quote. Free on the App Store. Plus Matrix for Claude Code, a GDPR-friendly WordPress spam filter and the AI loop that maintains it.">
  <section class="hero">
    <div class="hero-text">
      <p class="project">Matrix LLM · iPhone, iPad and Mac</p>
      <h1>Ask your documents. On your phone, offline.</h1>
      <p class="sub">Every answer comes with the exact passage it is based on. And Matrix maps who relates to what into a
      knowledge graph, with a quote behind every link. The models can run entirely on your device.</p>
      <div class="actions">
        <a class="go" href={SITE.matrixApp}>Get it on the App Store</a>
        <a class="go ghost" href="/projects/matrix/">See how it works</a>
      </div>
      <p class="free">Free to download.</p>
    </div>
    <figure class="stage">
      <div class="graph"><Image src={graph} alt="Matrix knowledge graph extracted from a public annual report: hundreds of entities linked by typed relations." widths={[800, 1400]} sizes="(min-width: 960px) 44rem, 100vw" loading="eager" /></div>
      <div class="phone"><Image src={iphoneAsk} alt="Matrix on an iPhone: a question about a sample contract, answered by Apple's on-device model, with the cited passage underneath." widths={[300, 600]} sizes="(min-width: 960px) 15rem, 38vw" loading="eager" /></div>
      <figcaption>Behind: a knowledge graph from one public annual report. In front: Apple's model answers on the iPhone, with the passage it used.</figcaption>
    </figure>
  </section>

  <section class="more">
    <div class="more-inner">
      <article class="door">
        <p class="for">For people using Claude Code</p>
        <h2>A third of the time. Half the tokens.</h2>
        <p>A free plugin gives Claude Code a local index of your PDFs, scans and charts, with file, page and passage for
        every answer. The same engine as the app.</p>
        <figure class="bars" aria-label="Average per question on 442 pages: 126 seconds and 651k input tokens without the plugin, 42 seconds and 303k input tokens with it.">
          <div class="metric">
            <p class="label">Seconds per question</p>
            <div class="row"><span class="lab">Alone</span><span class="bar" style="--v:100%"></span><span class="num">126</span></div>
            <div class="row"><span class="lab">Plugin</span><span class="bar on" style="--v:33.3%"></span><span class="num">42</span></div>
          </div>
          <div class="metric">
            <p class="label">Input tokens per question</p>
            <div class="row"><span class="lab">Alone</span><span class="bar" style="--v:100%"></span><span class="num">651k</span></div>
            <div class="row"><span class="lab">Plugin</span><span class="bar on" style="--v:46.5%"></span><span class="num">303k</span></div>
          </div>
          <figcaption>442 pages of EU regulations. Average of 4 questions, 2 runs each.</figcaption>
        </figure>
        <a class="go ghost" href="/projects/matrix-claude-code/">See the measurement</a>
      </article>
      <article class="door">
        <p class="for">For people building with AI agents</p>
        <h2>An AI that maintains my software — and has to ask first.</h2>
        <p>It reads support forums, writes the fix and passes checks no model can talk its way through.
        Every release, merge or forum reply then waits for one word from my phone.</p>
        <div class="mini"><LoopFlow /></div>
        <a class="go ghost" href="/projects/maintainer-loop/">Inside the loop</a>
      </article>
      <article class="door">
        <p class="for">For WordPress site owners</p>
        <h2>Form spam protection without Google.</h2>
        <p>A free plugin that stops spam with a tiny proof of work in the visitor's browser instead of
        tracking them. No cookies, no third-party calls, no puzzles to click. Runs on about 4,000 sites.</p>
        <ul class="ticks">
          <li>Works with the common form builders out of the box</li>
          <li>Nothing to configure at Google, nothing to disclose in a cookie banner</li>
        </ul>
        <a class="go ghost" href="/projects/gdpr-recaptcha/">About the plugin</a>
      </article>
    </div>
  </section>

  {posts.length > 0 && (
    <section class="latest">
      <div class="narrow">
        <h2>Latest notes</h2>
        <PostList posts={posts} />
        <a class="go ghost" href="/writing/">All writing</a>
      </div>
    </section>
  )}

  <section class="who">
    <div class="narrow">
      <p>Built by {SITE.author}, who works on AI and data in financial services and builds these after hours,
      mostly by directing and checking AI agents. <a href="/about/">About</a> · <a href="/cv/">CV</a></p>
    </div>
  </section>
</Base>

<style>
  .hero { max-width: 76rem; margin: 0 auto; padding: clamp(2.5rem, 6vw, 4.5rem) 16px clamp(2.5rem, 6vw, 4rem); display: grid; gap: 2.5rem 3.5rem; align-items: center; }
  @media (min-width: 960px) { .hero { grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); } }
  .project { margin: 0 0 .75rem; font-weight: 700; color: var(--accent); }
  h1, h2 { font-family: var(--display); font-weight: 800; letter-spacing: -.035em; line-height: .98; margin: 0 0 1.1rem; font-variation-settings: 'wdth' 78; }
  h1 { font-size: clamp(2.5rem, 5.2vw, 4.4rem); }
  .sub { font-size: clamp(1.08rem, 1.5vw, 1.2rem); line-height: 1.55; color: var(--muted); max-width: 36rem; margin: 0 0 1.5rem; }
  .actions { display: flex; flex-wrap: wrap; gap: .75rem; }
  .free { margin: .8rem 0 0; color: var(--muted); font-size: .95rem; }
  .stage { margin: 0; position: relative; }
  .graph { border-radius: 14px; border: 1px solid var(--line); overflow: hidden; aspect-ratio: 1 / 1; background: #fff; box-shadow: 0 30px 60px -32px rgba(18,20,40,.35); }
  .graph :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 20% 55%; display: block; }
  .phone { position: absolute; left: 12px; top: 5%; width: 40%; }
  .phone :global(img) { width: 100%; height: auto; display: block; border-radius: 1.4rem; box-shadow: 0 24px 48px -16px rgba(18,20,40,.55); }
  .stage figcaption { color: var(--muted); font-size: .9rem; line-height: 1.4; margin-top: .8rem; }
  @media (min-width: 960px) { .graph { aspect-ratio: 5 / 4; } .graph :global(img) { object-position: 45% 55%; } .phone { left: -1.5rem; width: 33%; } }
  .bars { margin: 0 0 1.5rem; display: grid; gap: 1.25rem; }
  .metric .label { margin: 0 0 .5rem; font-weight: 700; color: var(--fg); font-size: 1rem; }
  .row { display: grid; grid-template-columns: 3.4rem 1fr 3rem; gap: .6rem; align-items: center; margin-bottom: .4rem; }
  .door .metric p { margin-bottom: .5rem; }
  .row .lab { color: var(--muted); font-size: .9rem; }
  .bar { height: 1.2rem; border-radius: 5px; background: linear-gradient(to right, var(--line) var(--v), transparent var(--v)); }
  .bar.on { background: linear-gradient(to right, var(--accent) var(--v), transparent var(--v)); }
  .row .num { font: 800 1.05rem/1 var(--display); text-align: right; }
  .bars figcaption { color: var(--muted); font-size: .9rem; }
  .mini :global(img) { width: 100%; height: auto; border-radius: 12px; border: 1px solid var(--line); display: block; }
  .more { border-top: 1px solid var(--line); background: var(--surface); }
  .more-inner { max-width: 76rem; margin: 0 auto; padding: clamp(3rem, 7vw, 5rem) 16px; display: grid; grid-template-columns: 1fr; gap: 3.5rem 4rem; }
  @media (min-width: 1000px) { .more-inner { grid-template-columns: repeat(3, 1fr); } }
  .for { margin: 0 0 .6rem; font-weight: 700; color: var(--accent); }
  .door h2 { font-size: clamp(1.8rem, 3.4vw, 2.6rem); }
  .door p { color: var(--muted); font-size: 1.08rem; line-height: 1.55; margin: 0 0 1.25rem; max-width: 34rem; }
  .mini { margin: 0 0 1.5rem; }
  .ticks { margin: 0 0 1.5rem; padding-left: 1.2rem; color: var(--fg); }
  .ticks li { margin-bottom: .3rem; }
  .go { display: inline-block; font-weight: 700; text-decoration: none; color: var(--on-accent); background: var(--accent); padding: .7rem 1.2rem; border-radius: 999px; border: 2px solid var(--accent); }
  .go:hover { filter: brightness(1.1); }
  .go.ghost { background: transparent; color: var(--accent); }
  .go.ghost:hover { background: var(--accent); color: var(--on-accent); filter: none; }
  .narrow { max-width: 46rem; margin: 0 auto; padding: 0 16px; }
  .latest { padding: clamp(3rem, 7vw, 5rem) 0; border-top: 1px solid var(--line); }
  .latest h2 { font-size: clamp(1.8rem, 3.4vw, 2.6rem); }
  .who { padding: 2.5rem 0 4rem; color: var(--muted); border-top: 1px solid var(--line); }
  .who p { margin: 0; }
  :focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; }
</style>
