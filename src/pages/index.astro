---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import LoopFlow from '../components/diagrams/LoopFlow.astro';
import graph from '../assets/projects/matrix-graph.jpg';
import { publishedPosts } from '../lib';
import { SITE } from '../site';
const posts = (await publishedPosts()).slice(0, 4);
const jsonld = { '@context': 'https://schema.org', '@type': 'WebSite', name: 'programmiere.de', url: 'https://programmiere.de/', author: { '@type': 'Person', name: SITE.author } };
---
<Base wide jsonld={jsonld} description="Matrix: ask thousands of pages a question, offline on a Mac or iPhone, with the exact sentence as proof. Plus a Claude Code plugin for large document folders, a GDPR-friendly WordPress spam filter and the AI loop that maintains it.">
  <section class="hero">
    <div class="hero-text">
      <p class="project">Matrix</p>
      <h1>Ask a thousand pages a question. On a phone, offline.</h1>
      <p class="sub">Matrix reads whole document collections, answers with the exact sentence that proves it,
      and draws who-relates-to-what as a graph where every link carries its quote. It runs on a Mac or
      an iPhone — the documents never leave the device.</p>
      <a class="go" href="/projects/matrix/">See how it works</a>
    </div>
    <figure class="shot">
      <Image src={graph} alt="Matrix knowledge graph: thousands of entities and relations extracted from a company's annual report, each link labelled with its relation type." widths={[800, 1400, 2124]} sizes="(min-width: 1100px) 1100px, 100vw" loading="eager" />
      <figcaption>A real run: one public annual report became 4,385 entities and 1,919 relations — every link backed by a quote from the text.</figcaption>
    </figure>
  </section>

  <section class="more">
    <div class="more-inner">
      <article class="door">
        <p class="for">For people who use Claude Code</p>
        <h2>Big document folders, a third of the time.</h2>
        <p>A free plugin that gives Claude Code a local index of your PDFs, scans and charts. On 442 pages of EU
        regulations: 42 instead of 126 seconds per question, with file, page and passage for every answer.</p>
        <a class="go ghost" href="/projects/matrix-claude-code/">About the plugin</a>
      </article>
      <article class="door">
        <p class="for">For people building with AI agents</p>
        <h2>An AI that maintains my software — and has to ask first.</h2>
        <p>It reads support forums, writes the fix and passes checks no model can talk its way through.
        Every release, merge or forum reply then waits for one word from my phone.</p>
        <div class="mini"><LoopFlow /></div>
        <a class="go ghost" href="/projects/maintainer-loop/">Inside the loop</a>
      </article>
      <article class="door">
        <p class="for">For WordPress site owners</p>
        <h2>Form spam protection without Google.</h2>
        <p>A free plugin that stops spam with a tiny proof of work in the visitor's browser instead of
        tracking them. No cookies, no third-party calls, no puzzles to click. Runs on about 4,000 sites.</p>
        <ul class="ticks">
          <li>Works with the common form builders out of the box</li>
          <li>Nothing to configure at Google, nothing to disclose in a cookie banner</li>
        </ul>
        <a class="go ghost" href="/projects/gdpr-recaptcha/">About the plugin</a>
      </article>
    </div>
  </section>

  {posts.length > 0 && (
    <section class="latest">
      <div class="narrow">
        <h2>Latest notes</h2>
        <PostList posts={posts} />
        <a class="go ghost" href="/writing/">All writing</a>
      </div>
    </section>
  )}

  <section class="who">
    <div class="narrow">
      <p>Built by {SITE.author}, who works on AI and data in financial services and builds these after hours,
      mostly by directing and checking AI agents. <a href="/about/">About</a> · <a href="/cv/">CV</a></p>
    </div>
  </section>
</Base>

<style>
  .hero { max-width: 76rem; margin: 0 auto; padding: clamp(2.5rem, 7vw, 5rem) 16px clamp(2.5rem, 6vw, 4rem); }
  .hero-text { max-width: 48rem; }
  .project { margin: 0 0 .75rem; font-weight: 700; color: var(--accent); }
  h1, h2 { font-family: var(--display); font-weight: 800; letter-spacing: -.035em; line-height: .98; margin: 0 0 1.1rem; font-variation-settings: 'wdth' 78; }
  h1 { font-size: clamp(2.5rem, 6vw, 4.8rem); }
  .sub { font-size: clamp(1.08rem, 1.6vw, 1.25rem); line-height: 1.55; color: var(--muted); max-width: 40rem; margin: 0 0 1.5rem; }
  .shot { margin: clamp(2rem, 5vw, 3.5rem) 0 0; }
  .shot :global(img) { width: 100%; height: auto; border-radius: 16px; border: 1px solid var(--line); box-shadow: 0 30px 60px -30px rgba(18, 20, 40, .35); display: block; }
  .shot figcaption { margin-top: .8rem; color: var(--muted); font-size: .95rem; max-width: 48rem; }
  .more { border-top: 1px solid var(--line); background: var(--surface); }
  .more-inner { max-width: 76rem; margin: 0 auto; padding: clamp(3rem, 7vw, 5rem) 16px; display: grid; grid-template-columns: 1fr; gap: 3.5rem 4rem; }
  @media (min-width: 1000px) { .more-inner { grid-template-columns: repeat(3, 1fr); } }
  .for { margin: 0 0 .6rem; font-weight: 700; color: var(--accent); }
  .door h2 { font-size: clamp(1.8rem, 3.4vw, 2.6rem); }
  .door p { color: var(--muted); font-size: 1.08rem; line-height: 1.55; margin: 0 0 1.25rem; max-width: 34rem; }
  .mini { margin: 0 0 1.5rem; }
  .ticks { margin: 0 0 1.5rem; padding-left: 1.2rem; color: var(--fg); }
  .ticks li { margin-bottom: .3rem; }
  .go { display: inline-block; font-weight: 700; text-decoration: none; color: var(--on-accent); background: var(--accent); padding: .7rem 1.2rem; border-radius: 999px; border: 2px solid var(--accent); }
  .go:hover { filter: brightness(1.1); }
  .go.ghost { background: transparent; color: var(--accent); }
  .go.ghost:hover { background: var(--accent); color: var(--on-accent); filter: none; }
  .narrow { max-width: 46rem; margin: 0 auto; padding: 0 16px; }
  .latest { padding: clamp(3rem, 7vw, 5rem) 0; border-top: 1px solid var(--line); }
  .latest h2 { font-size: clamp(1.8rem, 3.4vw, 2.6rem); }
  .who { padding: 2.5rem 0 4rem; color: var(--muted); border-top: 1px solid var(--line); }
  .who p { margin: 0; }
  :focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; }
</style>
