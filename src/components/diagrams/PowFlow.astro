<svg class="diagram pow" viewBox="0 0 640 240" role="img" aria-labelledby="pw-t pw-d">
  <title id="pw-t">How the invisible check works</title>
  <desc id="pw-d">A human's browser solves a tiny puzzle in milliseconds while they type and the form goes through. A spam bot sending thousands of messages has to solve one puzzle per message, which makes spamming expensive.</desc>
  <g class="row">
    <rect x="10" y="20" width="150" height="80" rx="12" /><text x="85" y="55" text-anchor="middle">Visitor</text><text x="85" y="77" text-anchor="middle" class="s">types a message</text>
    <path class="a" d="M166 60 H214 M208 54 L216 60 L208 66" />
    <rect x="222" y="20" width="190" height="80" rx="12" /><text x="317" y="55" text-anchor="middle">Browser</text><text x="317" y="77" text-anchor="middle" class="s">solves a tiny puzzle · ~ms</text>
    <path class="a" d="M418 60 H466 M460 54 L468 60 L460 66" />
    <rect x="474" y="20" width="156" height="80" rx="12" class="good" /><text x="552" y="66" text-anchor="middle" class="gt">Sent ✓</text>
  </g>
  <g class="row">
    <rect x="10" y="140" width="150" height="80" rx="12" /><text x="85" y="175" text-anchor="middle">Spam bot</text><text x="85" y="197" text-anchor="middle" class="s">10,000 messages</text>
    <path class="a" d="M166 180 H214 M208 174 L216 180 L208 186" />
    <rect x="222" y="140" width="190" height="80" rx="12" /><text x="317" y="175" text-anchor="middle">10,000 puzzles</text><text x="317" y="197" text-anchor="middle" class="s">one per message</text>
    <path class="a" d="M418 180 H466 M460 174 L468 180 L460 186" />
    <rect x="474" y="140" width="156" height="80" rx="12" class="bad" /><text x="552" y="175" text-anchor="middle" class="bt">Not worth it</text><text x="552" y="197" text-anchor="middle" class="bs">or blocked</text>
  </g>
</svg>
<style>
  .pow { width: 100%; height: auto; display: block; }
  .pow text { fill: var(--fg); font: 700 16px var(--display); }
  .pow .s { fill: var(--muted); font: 500 12.5px var(--sans); }
  .pow rect { fill: var(--surface); stroke: var(--line-strong); stroke-width: 2; }
  .pow .a { stroke: var(--muted); stroke-width: 2.5; fill: none; stroke-linecap: round; stroke-linejoin: round; }
  .pow rect.good { fill: #0f7a4f; stroke: #0f7a4f; } .pow .gt { fill: #fff; }
  .pow rect.bad { fill: #b42318; stroke: #b42318; } .pow .bt { fill: #fff; } .pow .bs { fill: #ffd9d4; font: 500 12.5px var(--sans); }
</style>
