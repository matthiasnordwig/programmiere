{
  "permissions": {
    "additionalDirectories": [
      "~/matrix",
      "~/wp-plugins/gdpr-recaptcha"
    ],
    "allow": [
      "Bash(npm run build)",
      "Bash(npm run dev)",
      "Bash(npm run publish *)",
      "Bash(npm run publish-check *)",
      "Bash(git log *)",
      "Bash(git -C * log *)",
      "Bash(git status*)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git branch *)",
      "Bash(git diff*)",
      "Bash(npm run ship)"
    ],
    "deny": [
      "Edit(~/matrix/**)",
      "Edit(~/wp-plugins/gdpr-recaptcha/**)",
      "Read(~/wp-plugins/gdpr-recaptcha/loop/state/**)",
      "Read(~/wp-plugins/gdpr-recaptcha/LOOP-FUNDE.md)",
      "Read(~/wp-plugins/gdpr-recaptcha/server/**)",
      "Read(~/matrix/settings_backup*)",
      "Read(~/matrix/settings_run_cmd_backup.txt)",
      "Read(~/matrix/matrix.db)",
      "Read(~/matrix/eval_dbs/**)",
      "Read(~/matrix/Beipspieldokumente/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/publish-gate.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
